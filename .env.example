# Episode analysis. Either key switches the daily reading from heuristics-only
# to a model, with the heuristics kept as the floor. Both have free tiers:
#   Gemini — https://aistudio.google.com/apikey
#   Groq   — https://console.groq.com/keys
# Gemini wins if both are set.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GROQ_API_KEY=
# Optional model overrides (defaults: gemini-2.0-flash, llama-3.3-70b-versatile)
EXPO_PUBLIC_GEMINI_MODEL=
EXPO_PUBLIC_GROQ_MODEL=

# Claude (Sonnet) — companion conversation and the spoken question set only.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Hume AI — vocal prosody biomarkers
EXPO_PUBLIC_HUME_API_KEY=

# ElevenLabs — companion text-to-speech AND Scribe speech-to-text.
# One key covers both; with it set, spoken answers are transcribed.
EXPO_PUBLIC_ELEVENLABS_API_KEY=
# Voice for the companion. Blank uses "Sarah" (soft, calm). Other stock voices:
#   EXAVITQu4vr4xnSDxMaL  Sarah    — soft, warm        (default)
#   21m00Tcm4TlvDq8ikWAM  Rachel   — neutral, clear
#   XB0fDUnXU5powFXDhCwa  Charlotte— gentle, slower
#   onwK4e9ZLuTAKqWW03F9  Daniel   — low, steady male
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=
